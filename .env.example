# Speech runs locally. Fine-tuned Qwen setup requires private Hugging Face access.
# Existing installations keep faster-whisper unless explicitly changed.
WHISPER_BACKEND=faster-whisper
WHISPER_MODEL=large-v3-turbo
# Apple Silicon GPU alternative: WHISPER_BACKEND=mlx (see README)
MLX_WHISPER_MODEL=mlx-community/whisper-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional override; defaults to .venv Python, then system Python.
# PYTHON_BIN=/absolute/path/to/python
# Block paraphrases use local Ollama. If unavailable, labeled extraction is used.
OLLAMA_MODEL=qwen2.5:3b
SUMMARY_MODE=ollama
PORT=3000
# Recommended lecture mode: npm run setup:realtime sets these automatically.
# STT_BACKEND=sherpa
# LECTURE_SUMMARY_MODE=extractive (legacy cumulative requests only)
# STT_BACKEND takes precedence over WHISPER_BACKEND above.

# Fine-tuned Apple GPU mode: npm run setup:qwen (private HF login required once).
# STT_BACKEND=qwen-mlx
# QWEN_ASR_MODEL=mlx-community/Qwen3-ASR-1.7B-8bit
# QWEN_ASR_ADAPTER=yuson0701/qwen3-asr-1.7b-korean-lecture-lora-mlx
# QWEN_ASR_ADAPTER_REVISION=4432a3827098d104178e8470d73422b010f3c222
# The base is pinned to a8379a2e2f9e313c9292cdf1af4055ab56d50d55.
# Setup writes downloaded local snapshot paths. Tokens stay in the HF login cache.
# Base-only comparison: npm run setup:qwen -- --base-only (sets QWEN_ASR_ADAPTER=none).
# setup:qwen sets PYTHON_BIN to the isolated .venv-qwen environment.

# Optional local record directory. Defaults to data/lectures in this project.
# LECTURE_DATA_DIR=/absolute/path/to/lecture-records
