# No API key required. Download this model once before starting a lecture.
# Existing installations keep faster-whisper unless explicitly changed.
WHISPER_BACKEND=faster-whisper
WHISPER_MODEL=large-v3-turbo
# Apple Silicon GPU alternative: WHISPER_BACKEND=mlx (see README)
MLX_WHISPER_MODEL=mlx-community/whisper-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional override; defaults to .venv Python, then system Python.
# PYTHON_BIN=/absolute/path/to/python
# Block paraphrases use local Ollama. If unavailable, labeled extraction is used.
OLLAMA_MODEL=qwen2.5:3b
SUMMARY_MODE=ollama
PORT=3000
# Recommended lecture mode: npm run setup:realtime sets these automatically.
# STT_BACKEND=sherpa
# LECTURE_SUMMARY_MODE=extractive (legacy cumulative requests only)
# STT_BACKEND takes precedence over WHISPER_BACKEND above.
